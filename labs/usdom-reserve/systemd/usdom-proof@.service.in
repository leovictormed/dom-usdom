[Unit]
Description=Supervised immutable USDOM proof run %i
Documentation="file://@REPOSITORY@/labs/usdom-reserve/docs/SUPERVISED-LONG-PROOF-SERVICE-ETAPA1069-2026-10-26.txt"
After=local-fs.target
ConditionPathExists=%h/.config/usdom-proof/jobs/%i.json

[Service]
Type=exec
ExitType=cgroup
ExecStart=/usr/bin/python3 "@REPOSITORY@/labs/usdom-reserve/scripts/run-supervised-long-proof.py" --state-root %h/.local/state/usdom-proof --run-id %i --command-manifest %h/.config/usdom-proof/jobs/%i.json --expected-supervisor-sha256 @SUPERVISOR_SHA256@
Restart=no
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10min
SendSIGKILL=yes
FinalKillSignal=SIGKILL
OOMPolicy=stop
Nice=15
CPUWeight=10
IOWeight=100
MemoryHigh=5500M
MemoryMax=6500M
LimitCORE=0
TasksMax=256
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/usdom-proof
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
