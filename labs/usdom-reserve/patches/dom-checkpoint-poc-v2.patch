+#[test]
+fn checkpoint_id_binds_every_recorded_identity() {
+    let base = oracle(3, Hash256::from_bytes([3; 32]));
+    let id = base.id();
+    let mut variants = Vec::new();
+
+    let mut value = base;
+    value.sequence = 2;
+    variants.push(value);
+    let mut value = base;
+    value.previous_checkpoint = Hash256::from_bytes([1; 32]);
+    variants.push(value);
+    let mut value = base;
+    value.height += 1;
+    variants.push(value);
+    let mut value = base;
+    value.dom_block = Hash256::from_bytes([4; 32]);
+    variants.push(value);
+    let mut value = base;
+    value.dom_state_commitment = Hash256::from_bytes([5; 32]);
+    variants.push(value);
+    let mut value = base;
+    value.ethereum_chain_id += 1;
+    variants.push(value);
+    let mut value = base;
+    value.ethereum_block_number += 1;
+    variants.push(value);
+    let mut value = base;
+    value.ethereum_block = Hash256::from_bytes([6; 32]);
+    variants.push(value);
+    let mut value = base;
+    value.ethereum_receipts_root = Hash256::from_bytes([7; 32]);
+    variants.push(value);
+    let mut value = base;
+    value.checkpoint_contract[0] ^= 1;
+    variants.push(value);
+    let mut value = base;
+    value.log_index += 1;
+    variants.push(value);
+    let mut value = base;
+    value.verifier_config_hash = Hash256::from_bytes([8; 32]);
+    variants.push(value);
+    let mut value = base;
+    value.evidence_digest = Hash256::from_bytes([9; 32]);
+    variants.push(value);
+
+    assert!(variants.into_iter().all(|variant| variant.id() != id));
+}
