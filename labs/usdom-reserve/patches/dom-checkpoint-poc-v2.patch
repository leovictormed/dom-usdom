+#[test]
+fn persisted_policy_substitution_fails_closed_on_restart() {
+    let (dir, chain, hashes) = canonical_chain();
+    install(&chain.store, NETWORK_MAGIC_REGTEST, 5, oracle(3, hashes[3])).unwrap();
+    let mut bytes = chain
+        .store
+        .get_metadata(checkpoint::CHECKPOINT_KEY)
+        .unwrap()
+        .unwrap();
+    // Contract address begins at byte 193 in the fixed v2 encoding.
+    bytes[193] ^= 1;
+    chain
+        .store
+        .put_metadata(checkpoint::CHECKPOINT_KEY, &bytes)
+        .unwrap();
+    drop(chain);
+    let result = ChainState::open(
+        common::open_test_store(dir.path()),
+        Hash256::ZERO,
+        NETWORK_MAGIC_REGTEST,
+    );
+    assert!(
+        matches!(result, Err(error) if error.to_string().contains("checkpoint does not match pinned policy"))
+    );
+}
