diff --git a/crates/dom-chain/src/ethereum_checkpoint_poc.rs b/crates/dom-chain/src/ethereum_checkpoint_poc.rs
new file mode 100644
index 0000000..b182bef
--- /dev/null
+++ b/crates/dom-chain/src/ethereum_checkpoint_poc.rs
@@ -0,0 +1,230 @@
+//! Experimental persistent reorg barrier, not an Ethereum light client.
+//!
+//! Input is supplied by a TEST ORACLE, not authenticated consensus evidence.
+//! Installation is restricted to regtest and an already canonical DOM block.
+//! The certificate records the identities a real Ethereum proof must bind, but
+//! this module deliberately does not claim to verify any of those identities.
+//! It demonstrates only persistence, monotonic checkpoint chaining and the
+//! native fork-choice barrier.
+
+use blake2::digest::consts::U32;
+use blake2::{Blake2b, Digest};
+use dom_core::{DomError, Hash256, NETWORK_MAGIC_REGTEST};
+use dom_store::DomStore;
+
+/// Experimental metadata key, absent from production configuration.
+pub const CHECKPOINT_KEY: &[u8] = b"experimental/usdom/ethereum-checkpoint/v2";
+
+const ENCODING_VERSION: u8 = 2;
+const ENCODED_LENGTH: usize = 285;
+const CHECKPOINT_ID_DOMAIN: &[u8] = b"DOM_USDOM_ETHEREUM_CHECKPOINT_POC_V2";
+/// External chain fixed by this isolated experiment.
+pub const POC_ETHEREUM_CHAIN_ID: u64 = 1;
+/// Non-deployed test identity. It is not a production checkpoint contract.
+pub const POC_CHECKPOINT_CONTRACT: [u8; 20] = [0xcc; 20];
+/// Synthetic test configuration. It is not an audited verifier hash.
+pub const POC_VERIFIER_CONFIG_HASH: [u8; 32] = [0x44; 32];
+
+/// Checkpoint supplied by a test oracle. None of its Ethereum fields are verified.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct TestOracleCheckpoint {
+    /// Monotonic checkpoint sequence, beginning at one.
+    pub sequence: u64,
+    /// Identifier of the preceding checkpoint, or zero only for sequence one.
+    pub previous_checkpoint: Hash256,
+    /// DOM block height selected by the test oracle.
+    pub height: u64,
+    /// DOM block identifier at that height.
+    pub dom_block: Hash256,
+    /// Future native state/public-input commitment associated with the block.
+    pub dom_state_commitment: Hash256,
+    /// Ethereum chain identifier asserted by the test oracle.
+    pub ethereum_chain_id: u64,
+    /// Finalized Ethereum execution block number asserted by the test oracle.
+    pub ethereum_block_number: u64,
+    /// Finalized Ethereum execution block hash asserted by the test oracle.
+    pub ethereum_block: Hash256,
+    /// Receipts root asserted for the finalized Ethereum execution block.
+    pub ethereum_receipts_root: Hash256,
+    /// Contract asserted to have emitted/stored the checkpoint proposal.
+    pub checkpoint_contract: [u8; 20],
+    /// Log index asserted within the authenticated receipt.
+    pub log_index: u64,
+    /// Verifier/protocol configuration asserted by the proposal.
+    pub verifier_config_hash: Hash256,
+    /// Digest of the exact external proof transcript asserted by the oracle.
+    pub evidence_digest: Hash256,
+}
+
+impl TestOracleCheckpoint {
+    /// Deterministic identifier linking the monotonic checkpoint sequence.
+    pub fn id(&self) -> Hash256 {
+        let encoded = encode(self);
+        let mut hasher = Blake2b::<U32>::new();
+        hasher.update(CHECKPOINT_ID_DOMAIN);
+        hasher.update(encoded);
+        let digest = hasher.finalize();
+        let mut bytes = [0u8; 32];
+        bytes.copy_from_slice(&digest);
+        Hash256::from_bytes(bytes)
+    }
+}
+
+fn rejected(message: &str) -> DomError {
+    DomError::PolicyRejected(format!("CHECKPOINT_POC: {message}"))
+}
+
+fn nonzero_address(value: &[u8; 20]) -> bool {
+    value.iter().any(|byte| *byte != 0)
+}
+
+fn validate_shape(checkpoint: TestOracleCheckpoint) -> Result<(), DomError> {
+    if checkpoint.sequence == 0
+        || checkpoint.height == 0
+        || checkpoint.dom_block == Hash256::ZERO
+        || checkpoint.dom_state_commitment == Hash256::ZERO
+        || checkpoint.ethereum_chain_id == 0
+        || checkpoint.ethereum_block_number == 0
+        || checkpoint.ethereum_block == Hash256::ZERO
+        || checkpoint.ethereum_receipts_root == Hash256::ZERO
+        || !nonzero_address(&checkpoint.checkpoint_contract)
+        || checkpoint.verifier_config_hash == Hash256::ZERO
+        || checkpoint.evidence_digest == Hash256::ZERO
+        || (checkpoint.sequence == 1) != (checkpoint.previous_checkpoint == Hash256::ZERO)
+    {
+        return Err(rejected("invalid checkpoint identity"));
+    }
+    if checkpoint.ethereum_chain_id != POC_ETHEREUM_CHAIN_ID
+        || checkpoint.checkpoint_contract != POC_CHECKPOINT_CONTRACT
+        || checkpoint.verifier_config_hash.as_bytes() != &POC_VERIFIER_CONFIG_HASH
+    {
+        return Err(rejected("checkpoint does not match pinned policy"));
+    }
+    Ok(())
+}
+
+fn encode(checkpoint: &TestOracleCheckpoint) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(ENCODED_LENGTH);
+    bytes.push(ENCODING_VERSION);
+    bytes.extend_from_slice(&checkpoint.sequence.to_be_bytes());
+    bytes.extend_from_slice(checkpoint.previous_checkpoint.as_bytes());
+    bytes.extend_from_slice(&checkpoint.height.to_be_bytes());
+    bytes.extend_from_slice(checkpoint.dom_block.as_bytes());
+    bytes.extend_from_slice(checkpoint.dom_state_commitment.as_bytes());
+    bytes.extend_from_slice(&checkpoint.ethereum_chain_id.to_be_bytes());
+    bytes.extend_from_slice(&checkpoint.ethereum_block_number.to_be_bytes());
+    bytes.extend_from_slice(checkpoint.ethereum_block.as_bytes());
+    bytes.extend_from_slice(checkpoint.ethereum_receipts_root.as_bytes());
+    bytes.extend_from_slice(&checkpoint.checkpoint_contract);
+    bytes.extend_from_slice(&checkpoint.log_index.to_be_bytes());
+    bytes.extend_from_slice(checkpoint.verifier_config_hash.as_bytes());
+    bytes.extend_from_slice(checkpoint.evidence_digest.as_bytes());
+    debug_assert_eq!(bytes.len(), ENCODED_LENGTH);
+    bytes
+}
+
+fn take<const N: usize>(bytes: &[u8], cursor: &mut usize) -> [u8; N] {
+    let mut value = [0u8; N];
+    value.copy_from_slice(&bytes[*cursor..*cursor + N]);
+    *cursor += N;
+    value
+}
+
+fn decode(bytes: &[u8]) -> Result<TestOracleCheckpoint, DomError> {
+    if bytes.len() != ENCODED_LENGTH || bytes[0] != ENCODING_VERSION {
+        return Err(rejected("malformed persisted checkpoint"));
+    }
+    let mut cursor = 1;
+    let checkpoint = TestOracleCheckpoint {
+        sequence: u64::from_be_bytes(take(bytes, &mut cursor)),
+        previous_checkpoint: Hash256::from_bytes(take(bytes, &mut cursor)),
+        height: u64::from_be_bytes(take(bytes, &mut cursor)),
+        dom_block: Hash256::from_bytes(take(bytes, &mut cursor)),
+        dom_state_commitment: Hash256::from_bytes(take(bytes, &mut cursor)),
+        ethereum_chain_id: u64::from_be_bytes(take(bytes, &mut cursor)),
+        ethereum_block_number: u64::from_be_bytes(take(bytes, &mut cursor)),
+        ethereum_block: Hash256::from_bytes(take(bytes, &mut cursor)),
+        ethereum_receipts_root: Hash256::from_bytes(take(bytes, &mut cursor)),
+        checkpoint_contract: take(bytes, &mut cursor),
+        log_index: u64::from_be_bytes(take(bytes, &mut cursor)),
+        verifier_config_hash: Hash256::from_bytes(take(bytes, &mut cursor)),
+        evidence_digest: Hash256::from_bytes(take(bytes, &mut cursor)),
+    };
+    debug_assert_eq!(cursor, ENCODED_LENGTH);
+    validate_shape(checkpoint)?;
+    Ok(checkpoint)
+}
+
+/// Read bounded, versioned metadata; malformed data fails closed.
+pub fn load(store: &DomStore) -> Result<Option<TestOracleCheckpoint>, DomError> {
+    store
+        .get_metadata(CHECKPOINT_KEY)?
+        .map(|bytes| decode(&bytes))
+        .transpose()
+}
+
+/// Require the persisted anchor to exist in the current canonical history.
+pub fn ensure_current(store: &DomStore, tip_height: u64) -> Result<(), DomError> {
+    if let Some(checkpoint) = load(store)? {
+        if checkpoint.height > tip_height
+            || store.get_hash_at_height(checkpoint.height)?
+                != Some(*checkpoint.dom_block.as_bytes())
+        {
+            return Err(rejected("canonical history conflicts with checkpoint"));
+        }
+    }
+    Ok(())
+}
+
+/// Install a TEST ORACLE assertion only in regtest after local canonical alignment.
+/// Does not verify any Ethereum signature, finality, receipt, state or DOM proof.
+pub fn install_from_test_oracle(
+    store: &DomStore,
+    network_magic: u32,
+    tip_height: u64,
+    checkpoint: TestOracleCheckpoint,
+) -> Result<(), DomError> {
+    if network_magic != NETWORK_MAGIC_REGTEST {
+        return Err(rejected("test oracle is regtest-only"));
+    }
+    validate_shape(checkpoint)?;
+    ensure_current(store, tip_height)?;
+    if checkpoint.height > tip_height
+        || store.get_hash_at_height(checkpoint.height)? != Some(*checkpoint.dom_block.as_bytes())
+    {
+        return Err(rejected("test oracle checkpoint is not canonical"));
+    }
+    if let Some(old) = load(store)? {
+        if checkpoint == old {
+            return Ok(());
+        }
+        if checkpoint.sequence
+            != old
+                .sequence
+                .checked_add(1)
+                .ok_or_else(|| rejected("sequence overflow"))?
+            || checkpoint.previous_checkpoint != old.id()
+            || checkpoint.height <= old.height
+            || checkpoint.ethereum_block_number <= old.ethereum_block_number
+        {
+            return Err(rejected("checkpoint rollback, replacement or broken link"));
+        }
+    } else if checkpoint.sequence != 1 || checkpoint.previous_checkpoint != Hash256::ZERO {
+        return Err(rejected("first checkpoint must begin sequence"));
+    }
+    store.put_metadata(CHECKPOINT_KEY, &encode(&checkpoint))
+}
+
+/// Reject a reorg whose shared ancestor precedes the persisted checkpoint.
+/// Called before canonical block disconnection in the actual fork-choice path.
+pub fn check_reorg(
+    store: &DomStore,
+    tip_height: u64,
+    ancestor_height: u64,
+) -> Result<(), DomError> {
+    ensure_current(store, tip_height)?;
+    if load(store)?.is_some_and(|checkpoint| ancestor_height < checkpoint.height) {
+        return Err(rejected("reorg would undo checkpoint"));
+    }
+    Ok(())
+}
